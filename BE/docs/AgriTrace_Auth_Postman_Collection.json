            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"distributor_01\",\n  \"email\": \"dist01@agritrace.com\",\n  \"password\": \"Test@123456\",\n  \"fullName\": \"Nhà Phân Phối 01\",\n  \"roleId\": 4,\n  \"organizationId\": 4\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
